.search-bar {
  margin-bottom: 16rpx;
}

.search-input-wrap {
  background-color: #ffffff;
  border-radius: 40rpx;
  padding: 12rpx 24rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

.category-bar {
  margin-bottom: 16rpx;
}

.cat-scroll {
  white-space: nowrap;
  padding-bottom: 8rpx;
}

.cat-item {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  background-color: #ffffff;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #6b7280;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.04);
}

.cat-active {
  background-color: #3b82f6;
  color: #ffffff;
}

.comp-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  margin-right: 12rpx;
}

.meta-row {
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.8;
}

.meta-label {
  color: #9ca3af;
}

.meta-value {
  color: #4b5563;
}

.comp-actions {
  display: flex;
  justify-content: flex-end;
}

.register-btn {
  padding: 12rpx 32rpx;
  font-size: 26rpx;
}
