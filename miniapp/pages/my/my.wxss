.profile-wrap {
  background: linear-gradient(160deg, #3b82f6 0%, #1d4ed8 100%);
  margin: -24rpx -24rpx 0;
  padding: 48rpx 24rpx 80rpx;
  border-bottom-left-radius: 32rpx;
  border-bottom-right-radius: 32rpx;
}

.profile-card {
  display: flex;
  align-items: center;
}

.avatar-wrap {
  margin-right: 24rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  background-color: #ffffff;
}

.avatar-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  background-color: rgba(255, 255, 255, 0.25);
  color: #ffffff;
  font-size: 52rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.user-info {
  flex: 1;
  color: #ffffff;
}

.user-name {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.user-role {
  display: inline-block;
  background-color: rgba(255, 255, 255, 0.25);
  border-radius: 16rpx;
  font-size: 22rpx;
  padding: 2rpx 16rpx;
  margin-bottom: 8rpx;
}

.user-detail {
  font-size: 24rpx;
  opacity: 0.9;
}

.stats-card {
  margin-top: -48rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 32rpx 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.08);
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #3b82f6;
  line-height: 1.2;
}

.stat-pass { color: #10b981; }
.stat-review { color: #f59e0b; }

.stat-label {
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 4rpx;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background-color: #e5e7eb;
}

.menu-card {
  padding: 0 24rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.menu-item:last-child { border-bottom: none; }

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #1f2937;
}

.menu-arrow {
  font-size: 36rpx;
  color: #d1d5db;
}

.logout-btn {
  margin-top: 48rpx;
  color: #ef4444;
  border-color: #fecaca;
}

.logout-btn:active {
  background-color: #fef2f2;
}
