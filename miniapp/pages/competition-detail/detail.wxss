.cover-wrap {
  width: 100%;
  height: 400rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  background-color: #f3f4f6;
}

.cover-image {
  width: 100%;
  height: 100%;
}

.cover-placeholder {
  width: 100%;
  height: 320rpx;
  background: linear-gradient(135deg, #3b82f6, #1d4ed8);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.placeholder-icon {
  font-size: 120rpx;
}

.time-row {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
}

.time-label {
  width: 120rpx;
  font-size: 26rpx;
  color: #9ca3af;
  flex-shrink: 0;
}

.time-value {
  flex: 1;
  font-size: 26rpx;
  color: #1f2937;
}

.desc-content {
  font-size: 28rpx;
  color: #374151;
  line-height: 1.8;
  word-break: break-all;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background-color: #ffffff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.bottom-bar .btn-primary {
  font-size: 32rpx;
  padding: 24rpx 0;
}
