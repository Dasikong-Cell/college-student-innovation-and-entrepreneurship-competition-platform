.banner-wrap {
  margin-bottom: 24rpx;
}

.banner-swiper {
  width: 100%;
  height: 320rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.banner-item {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
  color: #ffffff;
}

.banner-0 {
  background: linear-gradient(135deg, #3b82f6, #1d4ed8);
}

.banner-1 {
  background: linear-gradient(135deg, #10b981, #047857);
}

.banner-2 {
  background: linear-gradient(135deg, #f59e0b, #b45309);
}

.banner-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.banner-subtitle {
  font-size: 26rpx;
  opacity: 0.9;
}

.notice-bar {
  padding: 20rpx 24rpx;
}

.notice-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.notice-text {
  flex: 1;
  color: #374151;
  font-size: 26rpx;
}

.notice-arrow {
  color: #9ca3af;
  font-size: 32rpx;
}

.more-link {
  font-size: 24rpx;
  color: #3b82f6;
}

.ann-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.ann-item:last-child {
  border-bottom: none;
}

.ann-title {
  flex: 1;
  font-size: 28rpx;
  color: #1f2937;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.comp-card {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}

.comp-cover-wrap {
  width: 180rpx;
  height: 140rpx;
  border-radius: 12rpx;
  overflow: hidden;
  margin-right: 20rpx;
  flex-shrink: 0;
  background-color: #f3f4f6;
  display: flex;
  align-items: center;
  justify-content: center;
}

.comp-cover {
  width: 100%;
  height: 100%;
}

.comp-cover-placeholder {
  font-size: 56rpx;
}

.comp-info {
  flex: 1;
  min-width: 0;
}

.comp-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
