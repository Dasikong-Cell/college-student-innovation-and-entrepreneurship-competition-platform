<view class="container">

  <view wx:if="{{loading}}">
    <view class="card">
      <view class="skeleton" style="height:60rpx;width:70%;margin-bottom:16rpx;"></view>
      <view class="skeleton" style="height:26rpx;width:50%;"></view>
    </view>
    <view class="card">
      <view class="skeleton" style="height:200rpx;margin-bottom:16rpx;"></view>
      <view class="skeleton" style="height:26rpx;width:80%;margin-bottom:8rpx;"></view>
      <view class="skeleton" style="height:26rpx;width:60%;"></view>
    </view>
  </view>

  <block wx:else>

    <view class="banner-wrap">
      <swiper class="banner-swiper" indicator-dots autoplay circular interval="4000" indicator-color="rgba(255,255,255,0.5)" indicator-active-color="#ffffff">
        <swiper-item wx:for="{{[1,2,3]}}" wx:key="*this">
          <view class="banner-item banner-{{index}}">
            <view class="banner-title">创新创业大赛</view>
            <view class="banner-subtitle">激发创新潜能 · 放飞创业梦想</view>
          </view>
        </swiper-item>
      </swiper>
    </view>

    <view class="notice-bar card flex-between" bindtap="goLogin">
      <view class="notice-icon">📢</view>
      <view class="notice-text">{{unreadCount > 0 ? ('你有 ' + unreadCount + ' 条未读消息') : '欢迎来到创新创业大赛平台'}}</view>
      <view class="notice-arrow">›</view>
    </view>

    <view class="section-title mt-24">最新公告</view>
    <view class="card">
      <block wx:if="{{announcements.length > 0}}">
        <view class="ann-item" wx:for="{{announcements}}" wx:key="id">
          <view class="flex-between">
            <view class="ann-title ellipsis">{{item.title || item.name}}</view>
            <view wx:if="{{item.category}}" class="tag tag-primary">{{item.category}}</view>
          </view>
          <view wx:if="{{item.publishTime || item.createdAt}}" class="text-secondary mt-8">{{item.publishTime || item.createdAt}}</view>
        </view>
      </block>
      <view wx:else class="empty-wrap">
        <view class="empty-icon">📋</view>
        <view class="text-muted">暂无公告</view>
      </view>
    </view>

    <view class="flex-between mt-24">
      <view class="section-title" style="margin-bottom:0;">热门大赛</view>
      <view class="more-link" bindtap="goCompetitionList">查看更多 ›</view>
    </view>

    <block wx:if="{{competitions.length > 0}}">
      <view class="card comp-card" wx:for="{{competitions}}" wx:key="id" bindtap="goCompetition" data-id="{{item.id}}">
        <view class="comp-cover-wrap">
          <image wx:if="{{item.coverImage}}" class="comp-cover" src="{{item.coverImage}}" mode="aspectFill" />
          <view wx:else class="comp-cover-placeholder">🏆</view>
        </view>
        <view class="comp-info">
          <view class="comp-title">{{item.title || item.name}}</view>
          <view class="flex mt-8" wx:if="{{item.category}}">
            <view class="tag tag-orange">{{item.category}}</view>
          </view>
          <view class="text-secondary mt-8" wx:if="{{item.deadline || item.registerEnd}}">
            截止: {{item.deadline || item.registerEnd}}
          </view>
        </view>
      </view>
    </block>
    <view wx:else class="card empty-wrap">
      <view class="empty-icon">🎯</view>
      <view class="text-muted">暂无进行中的大赛</view>
    </view>

  </block>
</view>
