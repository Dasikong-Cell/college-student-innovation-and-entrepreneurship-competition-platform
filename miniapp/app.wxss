page {
  background-color: #f5f7fa;
  color: #1f2937;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

.container {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  transition: box-shadow 0.2s;
}

.card:active {
  box-shadow: 0 1rpx 6rpx rgba(0, 0, 0, 0.08);
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  font-weight: 500;
  color: #374151;
  margin-bottom: 12rpx;
}

.text-muted {
  color: #6b7280;
  font-size: 24rpx;
}

.text-secondary {
  color: #9ca3af;
  font-size: 22rpx;
}

.flex {
  display: flex;
  align-items: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-wrap {
  flex-wrap: wrap;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.btn-primary {
  background-color: #3b82f6;
  color: #ffffff;
  border-radius: 12rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  text-align: center;
  line-height: 1.4;
}

.btn-primary:active {
  background-color: #2563eb;
}

.btn-primary[disabled] {
  background-color: #93c5fd;
  color: #ffffff;
}

.btn-secondary {
  background-color: #ffffff;
  color: #3b82f6;
  border: 2rpx solid #3b82f6;
  border-radius: 12rpx;
  padding: 18rpx 36rpx;
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
  line-height: 1.4;
}

.btn-secondary:active {
  background-color: #eff6ff;
}

.btn-block {
  display: block;
  width: 100%;
  box-sizing: border-box;
}

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  margin-right: 8rpx;
}

.tag-primary {
  background-color: #dbeafe;
  color: #1d4ed8;
}

.tag-green {
  background-color: #dcfce7;
  color: #15803d;
}

.tag-red {
  background-color: #fee2e2;
  color: #b91c1c;
}

.tag-orange {
  background-color: #ffedd5;
  color: #c2410c;
}

.tag-gray {
  background-color: #f3f4f6;
  color: #4b5563;
}

.tag-purple {
  background-color: #ede9fe;
  color: #6d28d9;
}

.divider {
  height: 1rpx;
  background-color: #e5e7eb;
  margin: 16rpx 0;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 16rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #3b82f6;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #374151;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.form-input,
.form-textarea {
  width: 100%;
  background-color: #f9fafb;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #1f2937;
  box-sizing: border-box;
}

.form-input:focus,
.form-textarea:focus {
  border-color: #3b82f6;
  background-color: #ffffff;
}

.form-textarea {
  min-height: 160rpx;
  width: 100%;
}

.skeleton {
  background: linear-gradient(90deg, #f0f0f0 25%, #e8e8e8 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s infinite;
  border-radius: 8rpx;
}

@keyframes skeleton-loading {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

.loading-wrap {
  padding: 60rpx 0;
  text-align: center;
  color: #9ca3af;
  font-size: 26rpx;
}

.empty-wrap {
  padding: 120rpx 0;
  text-align: center;
  color: #9ca3af;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.mt-8 { margin-top: 8rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mt-32 { margin-top: 32rpx; }
.mb-8 { margin-bottom: 8rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-24 { margin-bottom: 24rpx; }
.mr-8 { margin-right: 8rpx; }
.mr-16 { margin-right: 16rpx; }
.ml-8 { margin-left: 8rpx; }
.p-16 { padding: 16rpx; }
.p-24 { padding: 24rpx; }
