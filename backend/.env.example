# 服务端口（对应 application.yml server.port）
SERVER_PORT=8090

# 跨域允许的来源，逗号分隔；生产环境必须显式配置（不配置则仅允许本地前端）
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# 数据库密码（通过环境变量注入，生产务必覆盖）
DB_PASSWORD=123456

# JWT 签名密钥（生产环境必填，切勿使用默认值）
JWT_SECRET=change-me-in-production

# 微信小程序密钥（生产环境必填）
WX_SECRET=wx_demo_secret

# 文件上传目录（可通过 UPLOAD_DIR 覆盖）
UPLOAD_DIR=./uploads/competition
